# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# handover bundle (duplicate of the source tree)
Thr-Fit-Website-Handover.zip

# firebase emulators
.firebase/
*-debug.log

# scope notes — the contract PDF names the real client and unreleased brand
/docs/

# seed script service-account credentials — never commit these
/secrets/
*serviceAccount*.json
*service-account*.json
