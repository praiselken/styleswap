rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /listings/{listingId} {
      // The marketplace is browsable without an account.
      allow read: if true;

      // Anyone signed in — including anonymously — can list an item, but only
      // as themselves, and only with fields that hold their expected shape.
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 3
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 1000
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && request.resource.data.price <= 10000
                    && request.resource.data.photos is list
                    && request.resource.data.photos.size() > 0
                    && request.resource.data.photos.size() <= 6
                    && request.resource.data.status == 'active'
                    && (!("brand" in request.resource.data)
                        || (request.resource.data.brand is string && request.resource.data.brand.size() <= 40));

      // A seller owns their listing; the sellerId can never be reassigned.
      allow update: if request.auth != null
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.sellerId == resource.data.sellerId;

      allow delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
    }

    match /users/{userId} {
      // Profiles are public — sellers link to them from their listings.
      allow read: if true;

      // Only the account owner can create or edit their own profile, and only
      // with fields that hold their expected shape.
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 1
                    && request.resource.data.displayName.size() <= 60
                    && (!("bio" in request.resource.data)
                        || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
                    && (!("location" in request.resource.data)
                        || (request.resource.data.location is string && request.resource.data.location.size() <= 60));

      allow delete: if false;
    }

    match /favorites/{favoriteId} {
      // A favorite is only ever read back by its own owner, and the doc id
      // pins it to exactly one (user, listing) pair so there's nothing to
      // validate beyond ownership.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.listingId is string
                    && favoriteId == request.auth.uid + "_" + request.resource.data.listingId;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
