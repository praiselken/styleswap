rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /listings/{userId}/{photo} {
      // Listing photos are shown to browsers who aren't signed in.
      allow read: if true;

      // Sellers write only into their own folder, and only real images
      // within the 5MB cap the upload helper enforces client-side. Anonymous
      // sessions are never allowed to upload, even though the app itself no
      // longer creates them.
      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
